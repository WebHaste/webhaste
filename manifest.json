{
  "manifest_version": 3,
  "name": "ChromeSite",
  "version": "0.1.0",
  "description": "Build sites locally in Chrome, publish them to Cloudflare Pages.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.cloudflare.com/*",
    "https://api.netlify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ChromeSite",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
